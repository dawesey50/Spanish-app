{
  "expo": {
    "name": "Spanish App",
    "slug": "spanish-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/app/app_icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/app/splash_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spanishapp.learn",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Used to check your spoken Spanish pronunciation.",
        "NSMicrophoneUsageDescription": "Used to record your voice for speaking practice."
      }
    },
    "android": {
      "package": "com.spanishapp.learn",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-notifications",
      "@react-native-voice/voice"
    ]
  }
}
